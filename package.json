{
  "name": "hugo-ts-boilerplate-v1",
  "version": "0.0.1",
  "description": "Hugo site with TypeScript and Bun",
  "author": "DanneDevOoops",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "bun build ./assets/ts/main.ts --outdir ./assets/js --target browser --minify --watch",
    "dev:env": "./scripts/dev.sh",
    "dev:stage": "./scripts/dev.sh stage",
    "dev:prod": "./scripts/dev.sh prod",
    "build:ts": "bun build ./assets/ts/main.ts --outdir ./assets/js --target browser --minify",
    "build:css": "npx @tailwindcss/cli -i ./assets/css/scss/style.scss -o ./assets/css/style.css",
    "watch:css": "npx @tailwindcss/cli -i ./assets/css/scss/style.scss -o ./assets/css/style.css --watch",
    "build:all": "bun run build:css && bun run build:ts && hugo --minify",
    "build:dev": "./scripts/build.sh dev",
    "build:stage": "./scripts/build.sh stage",
    "build:prod": "./scripts/build.sh prod",
    "server": "hugo server -D --disableFastRender --noHTTPCache",
    "server:docker": "docker compose up --build hugo-dev",
    "server:docker:staging": "docker compose --profile staging up --build hugo-staging",
    "build:docker:production": "docker compose --profile production run --rm hugo-prod",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint assets/ts --ext .ts,.tsx",
    "lint:fix": "eslint assets/ts --ext .ts,.tsx --fix",
    "format": "prettier --write \"assets/ts/**/*.{ts,tsx}\" \"assets/css/**/*.css\" \"layouts/**/*.html\" \"content/**/*.md\" \"*.md\"",
    "format:ts": "prettier --write \"assets/ts/**/*.{ts,tsx}\"",
    "format:css": "prettier --write \"assets/css/**/*.css\"",
    "format:html": "prettier --write \"layouts/**/*.html\"",
    "format:md": "prettier --write \"content/**/*.md\" \"*.md\"",
    "format:check": "prettier --check \"assets/ts/**/*.{ts,tsx}\" \"assets/css/**/*.css\" \"layouts/**/*.html\" \"content/**/*.md\" \"*.md\"",
    "format:check:ts": "prettier --check \"assets/ts/**/*.{ts,tsx}\"",
    "format:check:css": "prettier --check \"assets/css/**/*.css\"",
    "format:check:html": "prettier --check \"layouts/**/*.html\"",
    "format:check:md": "prettier --check \"content/**/*.md\" \"*.md\"",
    "docs": "typedoc",
    "docs-md": "typedoc --plugin typedoc-plugin-markdown --out ./docs/typedoc/md/ ./assets/ts/",
    "docs:watch": "typedoc --watch"
  },
  "devDependencies": {
    "@boneskull/typedoc-plugin-mermaid": "0.2.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/cli": "4.2.1",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.19",
    "@testing-library/dom": "10.4.1",
    "@to-skills/typedoc": "0.5.1",
    "@vitest/coverage-v8": "4.0.18",
    "@vitest/ui": "4.0.18",
    "bun-types": "1.3.11",
    "eslint": "10.0.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "happy-dom": "20.8.9",
    "mermaid": "11.13.0",
    "prettier": "3.8.1",
    "prettier-plugin-go-template": "0.0.15",
    "tailwind-scrollbar": "4.0.2",
    "tailwindcss": "4.2.1",
    "typedoc-material-theme": "1.4.1",
    "typedoc-plugin-coverage": "4.0.2",
    "typedoc-plugin-dt-links": "2.0.47",
    "typedoc-plugin-frontmatter": "1.3.1",
    "typedoc-plugin-import-target": "1.4.0",
    "typedoc-plugin-inline-sources": "1.3.0",
    "typedoc-plugin-language-switcher": "1.0.2",
    "typedoc-plugin-llms-txt": "0.1.2",
    "typedoc-plugin-markdown": "4.11.0",
    "typedoc-plugin-md": "0.7.1",
    "typedoc-plugin-mdn-links": "5.1.1",
    "typedoc-plugin-merge-modules": "7.0.0",
    "typedoc-plugin-missing-exports": "4.1.2",
    "typedoc-plugin-redirect": "1.3.0",
    "typedoc-plugin-rename-defaults": "0.7.3",
    "typedoc-umlclass": "0.10.2",
    "typescript": "6.0.2",
    "typescript-eslint": "8.56.1",
    "vite-plugin-dts": "4.5.4",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.0.18"
  },
  "dependencies": {
    "@11ty/is-land": "5.0.1",
    "@tailwindcss/vite": "4.2.1",
    "htmx.org": "2.0.8",
    "lit": "3.3.2",
    "markdown-it": "^14.1.1",
    "micromatch": "^4.0.8",
    "typedoc": "0.28.17",
    "yaml": "^2.8.3",
    "zod": "4.3.6"
  }
}
