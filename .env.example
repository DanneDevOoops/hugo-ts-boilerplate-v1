# Example Environment Variables
# Copy this file to .env.dev, .env.stage, or .env.prod and fill in your values

# Hugo Configuration
HUGO_ENV=development
HUGO_BASE_URL=http://localhost:1313

# ===  API Configuration ===
# URL addresses
API_BASE_URL=https://localhost:1337/api
API_BASE_URL_V1="${API_BASE_URL}/v1"
API_BASE_URL_V2="${API_BASE_URL}/v2"
# API Security
API_KEY=your-api-key-here
API_TOKEN=your-api-token-here

# Google Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXX

# Site Configuration
SITE_TITLE="My Hugo Site"
SITE_DESCRIPTION="A modern Hugo site with TypeScript"

# Feature Flags
ENABLE_COMMENTS=false
ENABLE_ANALYTICS=false

# Build Configuration
MINIFY=false
BUILD_DRAFTS=true
