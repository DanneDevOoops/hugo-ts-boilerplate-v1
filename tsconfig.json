{
  "compilerOptions": {
    // JavaScript language level and module resolution.
    // These settings control how TypeScript understands modern syntax and imports.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "target": "ES2022",

    // Source layout and emit settings.
    // Note: Bun handles the actual build output in this project, so `noEmit` keeps
    // TypeScript in type-checking mode even though emit-related options are defined.
    "declaration": true,
    "declarationMap": true,
    "noEmit": true,
    "outDir": "./assets/js",
    "removeComments": true,
    "rootDir": "./assets/ts",
    "sourceMap": true,

    // Type safety and compatibility behavior.
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },

  // Limit type-checking to site source files.
  // `*.tsx` is included for future JSX/TSX support if you decide to use it.
  "include": ["assets/ts/**/*.ts", "assets/ts/**/*.tsx"],
  "exclude": ["node_modules", "dist", "public", "docs"]
}
